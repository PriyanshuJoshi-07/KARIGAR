# Database
DATABASE_URL="postgresql://karigar:karigar@localhost:5432/karigar?schema=public"

# Server
PORT=3001
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Demo mode – app works without external AI APIs
DEMO_MODE=true

# Optional AI providers (unused when DEMO_MODE=true)
OPENAI_API_KEY=
VISION_API_KEY=
SPEECH_API_KEY=
IMAGE_ENHANCE_API_KEY=

# Uploads
UPLOAD_DIR=server/uploads
MAX_IMAGE_MB=8
