    "@types/express": "^5.0.1",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.10",
    "@types/sanitize-html": "^2.13.0",
    "@types/supertest": "^6.0.2",
    "prisma": "^6.19.3",
